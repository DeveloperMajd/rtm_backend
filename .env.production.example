# Production environment for RTM's backend — this file documents every
# variable the deployed app needs; it is NOT the real file. Copy it to
# `.env` directly on the server (never commit the real one) and fill in
# every <PLACEHOLDER>.
#
# Generate APP_KEY locally with: docker compose -f docker-compose.prod.yml
# run --rm app php artisan key:generate --show   (then paste the output
# below — don't run key:generate directly against the real .env in place,
# since at that point APP_KEY is still empty and some commands need it set
# first; generating with --show and pasting avoids that chicken-and-egg).

APP_NAME=RTM
APP_ENV=production
APP_KEY=<PLACEHOLDER-run key:generate --show>
APP_DEBUG=false
APP_URL=https://api.rtm.developermajd.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Neon Postgres — the DIRECT connection string (no "-pooler" in the
# hostname). See the conversation notes on why direct rather than pooled:
# this app's connection count is small and bounded (PHP-FPM workers + one
# queue worker + Reverb), nowhere near where pooling starts to matter, and
# migrations require the direct string anyway.
DB_CONNECTION=pgsql
DB_URL=<PLACEHOLDER-neon-direct-connection-string>

# SESSION_DRIVER/CACHE_STORE/QUEUE_CONNECTION all run on `redis`: the
# `redis` container in docker-compose.prod.yml, on the stack's internal
# network next to the app (REDIS_HOST below is its service name). This
# traffic can't go to either managed service's free tier, because part of
# it never stops, even with nobody using the app: the queue worker checks
# for a job and reads its pause and restart signals from CACHE_STORE (once
# a second before `block_for` was set in config/queue.php, every 5 seconds
# or so since), and Reverb reads its own restart signal every 5 seconds.
# - On Upstash (until 2026-09-17), that idle loop was at least five
#   commands a second (three for the empty poll, two for the signals),
#   which used up the 500K/month free quota about a day after the first
#   deploy.
# - On `database` (Neon, from then on), it was about three queries a
#   second, which never left the compute idle for the 5 minutes it needs
#   to scale to zero, so it ran around the clock and used up the Free
#   plan's 100 CU-hours a month by mid-October, suspending the database
#   and the whole app with it. (Measured locally, an idle worker + Reverb:
#   ~460 Postgres transactions a minute on `database`, none on `redis`.)
# The container has no quota, so its polling costs nothing, and Neon now
# only sees queries from real requests. Nothing in Redis is durable data:
# see the redis service's comment for persistence and the memory cap.
#
# The queue container's command in docker-compose.prod.yml must match
# QUEUE_CONNECTION (`queue:work redis`): queue:work takes the connection as
# an argument and doesn't read QUEUE_CONNECTION itself.
#
# Presence (App\Services\PresenceService) uses the same Redis directly, not
# through the cache/session abstraction. Reverb's own Redis pub/sub stays
# off (REVERB_SCALING_ENABLED=false, the default): it's only for running
# several Reverb instances behind one app.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Shared parent of the frontend (rtm.developermajd.com) and this API
# (api.rtm.developermajd.com) — required so the Sanctum session cookie set
# by the API is actually sent back on requests from the frontend's origin.
SESSION_DOMAIN=.rtm.developermajd.com
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=reverb
# `r2` — attachments live in a private Cloudflare R2 bucket, reached only
# via presigned URLs (Attachment::temporaryUrl()). See the AWS_*/
# R2_ATTACHMENTS_BUCKET vars below and the comment above 'avatars' in
# config/filesystems.php for why avatars and attachments use two separate
# buckets rather than sharing one.
FILESYSTEM_DISK=r2
QUEUE_CONNECTION=redis

CACHE_STORE=redis
REDIS_CLIENT=phpredis
# The `redis` service in docker-compose.prod.yml, by its service name. No
# password: it publishes no port and is only on the stack's internal
# network. Leave REDIS_URL unset, since it overrides REDIS_HOST/REDIS_PORT
# (that's how the Upstash URL used to be wired in).
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=resend
MAIL_FROM_ADDRESS="noreply@developermajd.com"
MAIL_FROM_NAME="${APP_NAME}"
# developermajd.com is verified in Resend (DKIM TXT at resend._domainkey,
# SPF MX + TXT at `send`), so this sends to any address. Use a
# sending-access key restricted to that domain, created in the SAME Resend
# account that owns the domain: domains and keys are per-account, and a key
# from another account fails with "domain is not verified" even when the
# dashboard shows it as Verified. Before the domain was verified the sender
# had to be onboarding@resend.dev, and Resend's sandbox only delivers to the
# address the account itself is registered under.
RESEND_API_KEY=<PLACEHOLDER-resend-api-key>

FRONTEND_URL=https://rtm.developermajd.com
SANCTUM_STATEFUL_DOMAINS=rtm.developermajd.com
CORS_ALLOWED_ORIGINS_PATTERN=#^https://rtm\.developermajd\.com$#

# Same OAuth app as local dev — only the redirect URI differs, and that's
# already env-driven via APP_URL. Facebook was dropped from this project:
# Meta now requires Business Verification (ID/business docs, review time)
# to publish an app for real users, which is more friction than it's worth
# for a portfolio project's login screen.
GOOGLE_CLIENT_ID=<PLACEHOLDER>
GOOGLE_CLIENT_SECRET=<PLACEHOLDER>
GOOGLE_REDIRECT_URI="${APP_URL}/api/auth/google/callback"

# Fresh values for production — do not reuse the local-dev Reverb
# credentials. Any random strings work; e.g. `openssl rand -hex 16`.
REVERB_APP_ID=<PLACEHOLDER>
REVERB_APP_KEY=<PLACEHOLDER>
REVERB_APP_SECRET=<PLACEHOLDER>
# What the server process itself binds to inside its container.
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# What the outside world (browsers, via Caddy) actually connects to.
REVERB_HOST=ws.rtm.developermajd.com
REVERB_PORT=443
REVERB_SCHEME=https

# Cloudflare R2 — one API token (Account API token, Object Read & Write,
# scoped to both buckets below), two buckets:
# - AWS_BUCKET = the public-access bucket (avatars), AWS_URL = its public
#   r2.dev URL
# - R2_ATTACHMENTS_BUCKET = the private bucket (attachments), no public URL
AWS_ACCESS_KEY_ID=<PLACEHOLDER>
AWS_SECRET_ACCESS_KEY=<PLACEHOLDER>
AWS_DEFAULT_REGION=auto
AWS_BUCKET=rtm-avatars
AWS_ENDPOINT=<PLACEHOLDER-https://ACCOUNT_ID.r2.cloudflarestorage.com>
AWS_URL=<PLACEHOLDER-public-r2.dev-url>
AWS_USE_PATH_STYLE_ENDPOINT=true
R2_ATTACHMENTS_BUCKET=rtm-attachments
AVATAR_DISK=s3
