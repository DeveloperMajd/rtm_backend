# Production environment for RTM's backend — this file documents every
# variable the deployed app needs; it is NOT the real file. Copy it to
# `.env` directly on the server (never commit the real one) and fill in
# every <PLACEHOLDER>.
#
# Generate APP_KEY locally with: docker compose -f docker-compose.prod.yml
# run --rm app php artisan key:generate --show   (then paste the output
# below — don't run key:generate directly against the real .env in place,
# since at that point APP_KEY is still empty and some commands need it set
# first; generating with --show and pasting avoids that chicken-and-egg).

APP_NAME=RTM
APP_ENV=production
APP_KEY=<PLACEHOLDER-run key:generate --show>
APP_DEBUG=false
APP_URL=https://api.rtm.developermajd.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Neon Postgres — the DIRECT connection string (no "-pooler" in the
# hostname). See the conversation notes on why direct rather than pooled:
# this app's connection count is small and bounded (PHP-FPM workers + one
# queue worker + Reverb), nowhere near where pooling starts to matter, and
# migrations require the direct string anyway.
DB_CONNECTION=pgsql
DB_URL=<PLACEHOLDER-neon-direct-connection-string>

# SESSION_DRIVER/CACHE_STORE/QUEUE_CONNECTION run on `database` (Neon),
# not `redis`, even though Upstash is configured below and REDIS_URL is
# set. Originally these were `redis` — switched after Upstash's 500K/month
# free-tier command quota got burned through (mostly by testing traffic
# during development, not real usage) and started rejecting the Redis
# connection outright (`AUTH failed while reconnecting`), which broke
# every session read/write and the rate limiter (both go through
# CACHE_STORE) — i.e. most of the app, immediately, in production. Neon
# has real headroom left, the `sessions`/`cache`/`jobs` tables already
# exist (Laravel's default starter migration creates all three up front),
# and this app's traffic is nowhere near where a database-backed session/
# cache store would itself become the bottleneck. The queue container's
# command in docker-compose.prod.yml must match this (`queue:work
# database`, not `queue:work redis`) — Laravel's queue:work takes the
# connection as a CLI argument, it doesn't read QUEUE_CONNECTION for that.
#
# Redis itself isn't removed from the stack: presence and typing
# indicators (App\Services\PresenceService) talk to Redis directly, not
# through Laravel's cache/session abstraction, and stay down until Upstash
# access is restored (a quota reset, or an upgrade) — an accepted,
# deliberate gap, not an oversight. Reverb needs no Redis at all for
# single-instance operation (REVERB_SCALING_ENABLED=false, the default);
# only horizontal scaling across multiple Reverb instances would need it.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Shared parent of the frontend (rtm.developermajd.com) and this API
# (api.rtm.developermajd.com) — required so the Sanctum session cookie set
# by the API is actually sent back on requests from the frontend's origin.
SESSION_DOMAIN=.rtm.developermajd.com
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=reverb
# TODO: switch to `s3` once the Cloudflare R2 bucket is set up (not done
# yet) — until then attachments live on this container's own disk via the
# `storage-app` named volume, which persists across redeploys but isn't
# backed up and doesn't survive the volume itself being removed.
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# Redis is still configured and used directly by PresenceService (not
# through CACHE_STORE/SESSION_DRIVER — see the note above those two).
REDIS_CLIENT=phpredis
REDIS_URL=<PLACEHOLDER-upstash-redis-url>
# Kept even though CACHE_STORE isn't redis right now: the app's default
# config.php still points a 'cache' Redis connection at DB 1 for whenever
# something (or a future revert) uses it directly, and Upstash only
# supports logical database 0 (no SELECT to another index) — DB 1 would
# error. Key-prefixing (already configured via REDIS_PREFIX) keeps
# 'default' and 'cache' keys apart without needing separate numbered
# databases.
REDIS_CACHE_DB=0

MAIL_MAILER=resend
MAIL_FROM_ADDRESS="onboarding@resend.dev"
MAIL_FROM_NAME="${APP_NAME}"
# Sandbox mode until developermajd.com is verified in the Resend dashboard
# (deferred until deployment — see project notes): only delivers to the
# address the Resend account itself is registered under.
RESEND_API_KEY=<PLACEHOLDER-resend-api-key>

FRONTEND_URL=https://rtm.developermajd.com
SANCTUM_STATEFUL_DOMAINS=rtm.developermajd.com
CORS_ALLOWED_ORIGINS_PATTERN=#^https://rtm\.developermajd\.com$#

# New production OAuth apps — NOT the same credentials as local dev.
# Redirect URI for both: https://api.rtm.developermajd.com/api/auth/{provider}/callback
GOOGLE_CLIENT_ID=<PLACEHOLDER>
GOOGLE_CLIENT_SECRET=<PLACEHOLDER>
GOOGLE_REDIRECT_URI="${APP_URL}/api/auth/google/callback"

FACEBOOK_CLIENT_ID=<PLACEHOLDER>
FACEBOOK_CLIENT_SECRET=<PLACEHOLDER>
FACEBOOK_REDIRECT_URI="${APP_URL}/api/auth/facebook/callback"

# Fresh values for production — do not reuse the local-dev Reverb
# credentials. Any random strings work; e.g. `openssl rand -hex 16`.
REVERB_APP_ID=<PLACEHOLDER>
REVERB_APP_KEY=<PLACEHOLDER>
REVERB_APP_SECRET=<PLACEHOLDER>
# What the server process itself binds to inside its container.
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# What the outside world (browsers, via Caddy) actually connects to.
REVERB_HOST=ws.rtm.developermajd.com
REVERB_PORT=443
REVERB_SCHEME=https

# Object storage for attachments — not wired up yet (see FILESYSTEM_DISK
# above). Fill in once the Cloudflare R2 bucket exists.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=true
