APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=rtm_backend
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# Local dev uses the private `local` disk. In production set this to `r2` so
# message attachments land in object storage (the app disk is ephemeral).
FILESYSTEM_DISK=local
# Avatars default to the `public` disk (see config/filesystems.php). In
# production set this to `s3` — R2's public-access bucket.
# AVATAR_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Default: writes emails to storage/logs/laravel.log instead of sending them
# (nothing reaches a real inbox — safe zero-setup default for a fresh clone).
# For real delivery (e.g. to test forgot-password end to end), sign up at
# resend.com, create an API key, then set:
#   MAIL_MAILER=resend
#   MAIL_FROM_ADDRESS=onboarding@resend.dev
#   RESEND_API_KEY=re_...
# Without a verified domain, Resend's sandbox only delivers to the address
# you signed up with — verify a domain in their dashboard to lift that.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# RESEND_API_KEY=

# Object storage (production). Cloudflare R2 — S3-compatible, so the
# Laravel `s3`/`r2` disks (config/filesystems.php) work unchanged. One R2
# API token, two buckets: `AWS_BUCKET` is the public-access one avatars
# live on (AWS_URL is its public r2.dev/custom-domain URL); attachments
# live in a second, private bucket (`R2_ATTACHMENTS_BUCKET`, no public URL
# — only ever reached via a presigned temporaryUrl()). See the comment
# above config/filesystems.php's 'avatars' key for why they're split.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=true
R2_ATTACHMENTS_BUCKET=

VITE_APP_NAME="${APP_NAME}"

FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/auth/google/callback"
